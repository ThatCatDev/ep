{
  "run": {
    "tests": true
  },
  "issues": {
    "exclude-dirs-use-default": true,
    "exclude-files": [
      ".*_test.go"
    ],
    "exclude-dirs": [
      ".*/generated/*"
    ],
    "exclude-rules": [
      {
        "path": "_test.go",
        "linters": [
          "errcheck"
        ]
      }
    ]
  },
  "linters": {
    "enable": [
      "asciicheck",
      "errcheck",
      "exhaustive",
      "copyloopvar",
      "forbidigo",
      "gocyclo",
      "gofmt",
      "goimports",
      "gosimple",
      "govet",
      "ineffassign",
      "makezero",
      "misspell",
      "nakedret",
      "nestif",
      "nilerr",
      "nlreturn",
      "nolintlint",
      "staticcheck",
      "testpackage",
      "typecheck",
      "unconvert",
      "unused",
      "wastedassign",
      "whitespace"
    ]
  },
  "linters-settings": {
    "errcheck": {
      "check-blank": true
    }
  }
}
